{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for host, HUD (icon panel / cockpit / system tray / display tray), popup and notification windows",
  "windows": ["main", "icon-panel", "cockpit", "system-tray", "display-tray", "topmenu", "loading", "popup-*", "hintbar", "notification", "parameter-setup", "tutorial", "tips"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-available-monitors",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-show",
    "core:window:allow-hide",
    "opener:default",
    "dialog:default"
  ]
}
