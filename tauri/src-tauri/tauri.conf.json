{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "city-genesis",
  "version": "0.1.0",
  "identifier": "com.citygenesis.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Genesis UI Host",
        "width": 240,
        "height": 120,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../graphic-launch.toml",
      "../backend-launch.toml",
      "tools/height_map_bin2npy.py"
    ]
  }
}
